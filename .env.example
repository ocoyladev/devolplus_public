# Copiar a .env y ajustar. NUNCA commitear .env.
#
# Todos los valores tienen un default que permite arrancar la aplicación en modo
# demostración sin ninguna infraestructura: no hace falta configurar nada para
# ejecutarla por primera vez.

# --- Adaptador de back-office ---------------------------------------------
# Único valor incluido en esta distribución. Un despliegue real implementa
# BackofficeAdapter (ver MACRO/adapters/__init__.py) y lo registra ahí.
BACKOFFICE_ADAPTER=demo

# --- Autenticación ---------------------------------------------------------
# demo   : concede acceso a cualquier usuario, sin base de datos.
# oracle : valida contra la base corporativa de accesos (requiere las ORACLE_* de abajo).
AUTH_MODE=demo

# Dominio de correo exigido en el autoregistro.
AUTH_EMAIL_DOMAIN=example.org

# --- Base de accesos (solo si AUTH_MODE=oracle) ----------------------------
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CONNECT_TIMEOUT=20

# --- Ofuscación de credenciales guardadas ----------------------------------
# Ver README > "Limitaciones conocidas": es ofuscación reversible, no cifrado.
DEVOL_XOR_KEY=demo-xor-key

# --- Licenciamiento local --------------------------------------------------
DEVOL_LICENSE_SALT=demo-license-salt
DEVOL_LOG_EMAIL=admin@example.org
